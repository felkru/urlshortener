# Copy to .env for local runs. Never commit real values.
PORT=3000
# MongoDB connection string (database felkrucom, collections short_urls and shortener_auth)
db_uri=
# Where the app is reachable; used for the CSRF origin check and for printed short links
PUBLIC_ORIGIN=http://localhost:3000
# Signs the session cookie: openssl rand -hex 32
SESSION_SECRET=
# Bearer token for agents and scripts: openssl rand -hex 32
API_TOKEN=
# Opens /setup?token=... while no login exists: openssl rand -hex 32. Empty it afterwards.
SETUP_TOKEN=
